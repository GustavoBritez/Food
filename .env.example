# =============================================================================
# Carta App · Variables de Entorno (.env.example)
# Copia este archivo como .env.local y completa con tus credenciales
# =============================================================================

# --- SUPABASE (Database, Auth & Storage) ---
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Anon Key / Publishable Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key
# Service Role Key (EXCLUSIVO Servidor / Webhooks - NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# --- STRIPE ($30 USD / mes - Suscripciones Multi-Tenant) ---
# Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=tu_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=tu_stripe_publishable_key
# Stripe Dashboard > Products > Crear producto "$30 USD / mes" (Recurring) > Price ID
STRIPE_PRICE_ID_30USD=tu_stripe_price_id
# Stripe Dashboard > Developers > Webhooks > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=tu_stripe_webhook_secret

# --- SITIO PÚBLICO ---
# En local: http://localhost:3000 | En producción: https://tudominio.com (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
