# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública del sitio (sin barra final). Es la que va dentro del QR: https://[dominio]/p/[slug]
# En local: http://localhost:3000  |  En producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
